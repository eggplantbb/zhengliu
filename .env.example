# Server
PORT=3000

# Simple access control (optional — leave empty to disable auth)
SITE_TOKEN=

# CORS (production: set to your domain, e.g. https://example.com)
CORS_ORIGIN=*

# WeChat Reading API — get from https://weread.qq.com/r/weread-skills
WEREAD_API_KEY=wrk-xxxxxxxx

# LLM (OpenAI-compatible, e.g. DeepSeek)
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Optional: MaoZeDongAnthology path override
# MAOXUAN_KB_PATH=./vendor/MaoZeDongAnthology
